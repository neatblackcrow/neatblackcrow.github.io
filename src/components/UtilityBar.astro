---
import { LOCALE_META, type Locale } from '../i18n/config';
import { getAlternateLinks, getUi } from '../i18n/utils';

interface NavSection {
  readonly id: string;
  readonly label: string;
}

interface Props {
  locale: Locale;
  sections: NavSection[];
}

const { locale, sections } = Astro.props;
const ui = getUi(locale);
const meta = LOCALE_META[locale];
const alternates = getAlternateLinks(Astro.site);
---

<nav class="utility-bar no-print" aria-label={ui.navLabel}>
  <div class="container utility-inner">
    <ul class="jump-list">
      {
        sections.map((section) => (
          <li>
            <a class="jump-link" href={`#${section.id}`} data-jump-link>
              {section.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="utility-actions">
      <div class="lang-switch" role="group" aria-label={ui.actions.switchLanguage}>
        {
          alternates.map((alt) => (
            <a
              class="lang-link"
              href={alt.relativePath}
              hreflang={alt.hreflang}
              lang={alt.hreflang}
              aria-current={alt.locale === locale ? 'page' : undefined}
            >
              {alt.label}
            </a>
          ))
        }
      </div>

      <button
        type="button"
        class="utility-btn"
        data-theme-toggle
        aria-pressed="false"
        aria-label={ui.actions.toggleThemeToDark}
        data-label-dark={ui.actions.toggleThemeToDark}
        data-label-light={ui.actions.toggleThemeToLight}
        data-short-dark={ui.actions.themeShortDark}
        data-short-light={ui.actions.themeShortLight}
      >
        <span data-theme-label>{ui.actions.themeShortDark}</span>
      </button>

      <button type="button" class="utility-btn" data-print-trigger>
        {ui.actions.print}
      </button>

      <a class="utility-btn utility-btn-primary" href={meta.pdfPath} download={meta.pdfFilename}>
        {ui.actions.downloadPdf}
      </a>
    </div>
  </div>
</nav>

<style>
  .utility-bar {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    background-color: var(--bg-elevated);
    border-block-end: 1px solid var(--border-hairline);
  }

  .utility-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-2);
  }

  .jump-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    min-inline-size: 0;
  }

  .jump-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--text-muted);
    text-decoration: none;
    border-block-end: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  :global(html[lang='th']) .jump-link {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .jump-link:hover,
  .jump-link[aria-current='location'] {
    color: var(--text-primary);
    border-block-end-color: var(--accent-primary);
  }

  .utility-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .lang-link,
  .utility-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 44px;
    min-inline-size: 44px;
    padding-inline: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1;
    text-decoration: none;
    color: var(--text-secondary);
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .lang-link + .lang-link {
    border-inline-start: 1px solid var(--border-hairline);
  }

  .lang-link:hover,
  .utility-btn:hover {
    background-color: var(--bg-surface);
    color: var(--text-primary);
  }

  .lang-link[aria-current='page'] {
    background-color: var(--accent-subtle);
    color: var(--accent-text);
    font-weight: 500;
  }

  .utility-btn {
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    background-color: var(--bg-elevated);
  }

  .utility-btn-primary {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    font-weight: 500;
  }

  .utility-btn-primary:hover {
    background-color: var(--accent-subtle);
    color: var(--accent-hover);
  }

  @media (min-width: 480px) {
    .jump-link {
      min-block-size: 32px;
    }

    .lang-link,
    .utility-btn {
      min-block-size: 32px;
      min-inline-size: auto;
      padding-inline: 0.625rem;
    }
  }
</style>
