---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';
import { getUi } from '../i18n/utils';

interface Props {
  items: CollectionEntry<'cv'>['data']['education'];
  locale: Locale;
}

const { items, locale } = Astro.props;
const ui = getUi(locale);
---

<section id="education" class="cv-section" aria-labelledby="heading-education">
  <div class="cv-section-header">
    <h2 id="heading-education" class="cv-section-title">{ui.sections.education}</h2>
  </div>

  <div class="cv-entries">
    {
      items.map((item) => (
        <article class="cv-entry">
          <div class="cv-entry-meta">
            <time class="cv-entry-period" datetime={item.startDate}>
              {item.period}
            </time>
            {item.location && <span class="cv-entry-location">{item.location}</span>}
          </div>

          <div class="cv-entry-body">
            <h3 class="cv-entry-title">{item.institution}</h3>
            <p class="cv-entry-subtitle">
              {item.degree}
              {item.honors ? ` (${item.honors})` : ''}
            </p>
            {item.gpa && (
              <p class="edu-gpa tabular-nums">
                {ui.labels.gpa}: {item.gpa}
              </p>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .edu-gpa {
    margin-block-start: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
