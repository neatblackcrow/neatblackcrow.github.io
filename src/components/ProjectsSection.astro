---
import type { CollectionEntry } from 'astro:content';
import { isNonEmpty } from '../domain/adt.ts';
import { asProjectId, stripUrlSchemeAndTrailingSlash } from '../domain/cv.ts';
import { toSkillTags, type FilterableProject } from '../domain/filter.ts';
import type { Locale } from '../i18n/config';
import { getUi } from '../i18n/utils';
import ProjectSkillFilter from '../islands/ProjectSkillFilter';

interface Props {
  items: CollectionEntry<'cv'>['data']['projects'];
  locale: Locale;
}

const { items, locale } = Astro.props;
const ui = getUi(locale);

const filterableProjects: readonly FilterableProject[] = items.map((item) => ({
  id: asProjectId(item.id),
  name: item.name,
  tags: toSkillTags(item.tags),
  searchText: [item.name, item.summary, ...item.highlights, ...item.tags]
    .join(' ')
    .toLowerCase(),
}));

const uniqueTags = toSkillTags(
  Array.from(new Set(items.flatMap((item) => item.tags))),
);
---

<section id="projects" class="cv-section" aria-labelledby="heading-projects">
  <div class="cv-section-header">
    <h2 id="heading-projects" class="cv-section-title">{ui.sections.projects}</h2>
  </div>

  <div class="csr-only no-print">
    <ProjectSkillFilter
      client:idle
      projects={filterableProjects}
      tags={uniqueTags}
      strings={ui.filter}
    />
  </div>

  <div class="cv-entries" data-projects-list>
    {
      items.map((project) => (
        <article
          class="cv-entry"
          data-project-card
          data-project-id={project.id}
        >
          <div class="cv-entry-meta">
            {isNonEmpty(project.tags) && (
              <p class="project-meta-stack">{project.tags.join(' · ')}</p>
            )}
            {project.repository ? (
              <a
                class="project-meta-link inline-link"
                href={project.repository}
                target="_blank"
                rel="noopener noreferrer"
              >
                {ui.labels.repository}
              </a>
            ) : (
              project.liveUrl && (
                <a
                  class="project-meta-link inline-link"
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {ui.labels.liveDemo}
                </a>
              )
            )}
          </div>

          <div class="cv-entry-body">
            <h3 class="cv-entry-title">{project.name}</h3>
            <p class="project-summary">{project.summary}</p>

            {isNonEmpty(project.highlights) && (
              <ul class="cv-bullets">
                {project.highlights.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}

            {(project.repository || project.liveUrl || isNonEmpty(project.links)) && (
              <p class="project-links">
                {project.repository && (
                  <span class="project-link-item">
                    <a
                      class="inline-link"
                      href={project.repository}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {stripUrlSchemeAndTrailingSlash(project.repository)}
                    </a>
                  </span>
                )}
                {project.liveUrl && (
                  <span class="project-link-item">
                    {ui.labels.liveDemo}:{' '}
                    <a
                      class="inline-link"
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {stripUrlSchemeAndTrailingSlash(project.liveUrl)}
                    </a>
                  </span>
                )}
                {project.links.map((extra) => (
                  <span class="project-link-item">
                    <a
                      class="inline-link"
                      href={extra.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {extra.label}
                    </a>{' '}
                    <span class="print-url print-only">({extra.url})</span>
                  </span>
                ))}
              </p>
            )}

            {project.demoCredentials && (
              <div class="demo-credentials">
                <span class="demo-label">{ui.labels.demoAccount}:</span>
                <span class="demo-field">
                  <span class="demo-key">{ui.labels.demoUsername}</span>
                  <code class="demo-code">{project.demoCredentials.username}</code>
                  <button
                    type="button"
                    class="copy-btn no-print"
                    data-copy-button
                    data-copy-value={project.demoCredentials.username}
                    data-copied-label={ui.actions.copied}
                    data-failed-label={ui.actions.copyFailed}
                    aria-label={`${ui.actions.copyPrefix} ${ui.labels.demoUsername}`}
                  >
                    {ui.actions.copyPrefix}
                  </button>
                </span>
                <span class="demo-field">
                  <span class="demo-key">{ui.labels.demoPassword}</span>
                  <code class="demo-code">{project.demoCredentials.password}</code>
                  <button
                    type="button"
                    class="copy-btn no-print"
                    data-copy-button
                    data-copy-value={project.demoCredentials.password}
                    data-copied-label={ui.actions.copied}
                    data-failed-label={ui.actions.copyFailed}
                    aria-label={`${ui.actions.copyPrefix} ${ui.labels.demoPassword}`}
                  >
                    {ui.actions.copyPrefix}
                  </button>
                </span>
              </div>
            )}

            {isNonEmpty(project.tags) && (
              <ul class="tag-list">
                {project.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .project-meta-stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: var(--leading-snug);
  }

  .project-meta-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    inline-size: fit-content;
  }

  .project-summary {
    margin-block-start: var(--space-2);
    color: var(--text-secondary);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .demo-credentials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-block-start: var(--space-2);
    padding-block: 0.35rem;
    padding-inline: var(--space-3);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    background-color: var(--bg-surface);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .demo-label {
    color: var(--text-muted);
  }

  .demo-field {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    min-inline-size: 0;
  }

  .demo-key {
    color: var(--text-muted);
  }

  .demo-code {
    font-family: var(--font-mono);
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    padding-block: 0.1rem;
    padding-inline: 0.4rem;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    background-color: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.4;
    color: var(--text-muted);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .copy-btn:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .copy-btn[data-copied='true'] {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  @media print {
    .demo-credentials {
      background-color: #ffffff !important;
      padding-block: 0.2rem;
      padding-inline: 0.45rem;
      font-size: 7.75pt;
    }
  }

  @media (min-width: 768px) {
    .project-meta-link {
      display: none;
    }
  }
</style>
