---
import type { CollectionEntry } from 'astro:content';
import { isCurrentRole, toEmploymentSpan } from '../domain/cv.ts';
import { LOCALE_META, type Locale } from '../i18n/config';
import {
  getAbsoluteUrl,
  getAlternateLinks,
  getDefaultCanonicalUrl,
  getLocalizedPath,
} from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'cv'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { seo, profile, skills, experience, education, languages, lastUpdated } = entry.data;
const meta = LOCALE_META[locale];

const canonicalUrl = getAbsoluteUrl(Astro.site, getLocalizedPath(locale));
const alternates = getAlternateLinks(Astro.site);
const xDefaultUrl = getDefaultCanonicalUrl(Astro.site);
const ogImageUrl = getAbsoluteUrl(Astro.site, '/og-image.png');
const faviconUrl = getAbsoluteUrl(Astro.site, '/favicon.svg');

const sameAs = [profile.githubUrl, profile.linkedinUrl, profile.websiteUrl].filter(
  (item): item is string => Boolean(item),
);

const knowsAbout = Array.from(new Set(skills.flatMap((group) => group.items)));

const currentRole = experience.find((item) => isCurrentRole(toEmploymentSpan(item)));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonicalUrl,
  inLanguage: meta.htmlLang,
  dateModified: lastUpdated,
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.headline,
    description: seo.description,
    url: canonicalUrl,
    email: `mailto:${profile.email}`,
    homeLocation: {
      '@type': 'Place',
      name: profile.location,
    },
    sameAs,
    knowsAbout,
    ...(currentRole
      ? {
          worksFor: {
            '@type': 'Organization',
            name: currentRole.organization,
            ...(currentRole.organizationUrl ? { url: currentRole.organizationUrl } : {}),
          },
        }
      : {}),
    alumniOf: education.map((edu) => ({
      '@type': 'CollegeOrUniversity',
      name: edu.institution,
    })),
    knowsLanguage: languages.map((lang) => lang.name),
  },
};
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="author" content={profile.name} />
<link rel="icon" type="image/svg+xml" href={faviconUrl} />
<link rel="canonical" href={canonicalUrl} />

{
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<meta property="og:type" content="profile" />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={meta.ogLocale} />
{
  alternates
    .filter((alt) => alt.locale !== locale)
    .map((alt) => (
      <meta property="og:locale:alternate" content={LOCALE_META[alt.locale].ogLocale} />
    ))
}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={seo.title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={ogImageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
